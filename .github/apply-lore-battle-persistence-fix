#!/usr/bin/env python3
from pathlib import Path

path = Path('app/lib/screens/journey_screen.dart')
text = path.read_text(encoding='utf-8')

load_marker = "    step = _appState.beijingJourneyStep;\n"
load_patch = (
    "    step = _appState.beijingJourneyStep;\n"
    "    _loreBattleCompleted = _experience.id == 'beijing-summer-palace' &&\n"
    "        _appState.beijingJourneyFurthestStep > 3;\n"
)
if "_appState.beijingJourneyFurthestStep > 3" not in text:
    text = text.replace(load_marker, load_patch, 1)

old_persist = """  Future<void> _persistProgress({int? overrideStep}) {
    return _appState.saveJourneyProgress(
      step: overrideStep ?? step,
      wonder: wonderController.text,
      express: expressController.text,
      memory: memoryController.text,
    );
  }
"""
new_persist = """  Future<void> _persistProgress({int? overrideStep}) {
    final persistedStep = overrideStep ??
        (_experience.id == 'beijing-summer-palace' &&
                _loreBattleCompleted &&
                step == 3
            ? 4
            : step);
    return _appState.saveJourneyProgress(
      step: persistedStep,
      wonder: wonderController.text,
      express: expressController.text,
      memory: memoryController.text,
    );
  }
"""
if "final persistedStep = overrideStep" not in text:
    text = text.replace(old_persist, new_persist, 1)

callback_marker = "          setState(() => _loreBattleCompleted = true);\n"
callback_patch = (
    "          setState(() => _loreBattleCompleted = true);\n"
    "          unawaited(_persistProgress(overrideStep: 4));\n"
)
if "unawaited(_persistProgress(overrideStep: 4));" not in text:
    text = text.replace(callback_marker, callback_patch, 1)

path.write_text(text, encoding='utf-8')
