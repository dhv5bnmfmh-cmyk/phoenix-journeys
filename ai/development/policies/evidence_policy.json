{
  "policy_id": "phoenix-development-agent-evidence-policy",
  "version": "1.2.0",
  "authority_class": "TRUSTED_BASE_EVIDENCE_TYPE_INVENTORY",
  "evidence_types": [
    "repository",
    "commit",
    "diff",
    "changed_paths",
    "test",
    "ci",
    "workflow",
    "founder"
  ],
  "type_specific_authority": {
    "repository": {
      "producer": "live_github_pull_request_identity",
      "terminal_proof_required": true
    },
    "commit": {
      "producer": "live_github_commit_and_candidate_git_identity",
      "terminal_proof_required": true
    },
    "diff": {
      "producer": "trusted_git_diff",
      "terminal_proof_required": true
    },
    "changed_paths": {
      "producer": "trusted_git_diff_name_only",
      "terminal_proof_required": true
    },
    "test": {
      "producer": "trusted_terminal_node_test_result",
      "terminal_proof_required": true
    },
    "ci": {
      "producer": "trusted_github_api_workflow_or_check_record",
      "terminal_proof_required": true
    },
    "workflow": {
      "producer": "trusted_github_actions_run_identity",
      "terminal_proof_required": true
    },
    "founder": {
      "producer": "trusted_github_api_founder_authorization_record",
      "terminal_proof_required": true
    }
  },
  "required_fields": [
    "evidence_id",
    "evidence_type",
    "source",
    "command_or_path",
    "candidate_sha",
    "produced_at",
    "result",
    "evidence_level",
    "limitations"
  ],
  "binding_fields": [
    "base_sha",
    "task_contract_digest",
    "governance_body_digest",
    "workflow_run_id",
    "run_attempt"
  ],
  "evidence_levels": [
    "VERIFIED",
    "PARTIALLY_VERIFIED",
    "UNVERIFIED",
    "CONTRADICTORY"
  ],
  "binding_rules": {
    "candidate_sha_must_equal_current_head_for_pass": true,
    "old_candidate_evidence_may_be_historical_only": true,
    "queued_or_in_progress_is_not_success": true,
    "not_run_must_remain_not_run": true,
    "checkbox_is_not_evidence": true,
    "preview_deployment_is_not_product_pass": true,
    "candidate_requested_type_does_not_create_evidence": true,
    "unknown_evidence_type_is_blocked": true,
    "fresh_audit_must_not_accept_previous_evidence": true,
    "reaudit_requires_previous_evidence_identity": true,
    "self_asserted_ci_json_is_forbidden": true,
    "self_asserted_founder_json_is_forbidden": true
  },
  "github_record_authority": {
    "token_source": "TRUSTED_WORKFLOW_GITHUB_TOKEN",
    "candidate_token_permitted": false,
    "candidate_api_endpoint_permitted": false,
    "http_failure_behavior": "FAIL_CLOSED",
    "ci": {
      "accepted_references": [
        "WORKFLOW_RUN_ID",
        "CHECK_RUN_ID"
      ],
      "allowed_workflow_names": [
        "Phoenix Agent Audit"
      ],
      "allowed_check_names": [
        "Phoenix Agent Bootstrap Source Tests",
        "Trusted read-only governance audit"
      ],
      "allowed_events": [
        "pull_request",
        "pull_request_target",
        "workflow_dispatch"
      ],
      "terminal_status": "completed",
      "success_conclusion": "success",
      "exact_head_required": true,
      "exact_run_attempt_required": true
    },
    "founder": {
      "accepted_references": [
        "PULL_REQUEST_REVIEW_ID",
        "ISSUE_OR_PR_COMMENT_ID"
      ],
      "allowed_github_identities": [
        "dhv5bnmfmh-cmyk"
      ],
      "allowed_author_associations": [
        "OWNER"
      ],
      "schema": "ai/development/schemas/founder_authorization.schema.json",
      "exact_repository_required": true,
      "exact_pr_required": true,
      "exact_head_required": true,
      "exact_action_required": true,
      "issued_at_must_match_github_record": true,
      "expired_or_revoked_is_blocked": true
    }
  },
  "external_disclosure": {
    "default": "NOT_PERMITTED",
    "unpublished_content_to_unapproved_service": "BLOCKED"
  }
}
