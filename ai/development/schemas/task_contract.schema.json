{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://phoenix.local/schemas/task_contract.schema.json",
  "title": "Phoenix Development Agent Task Contract",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "task_id",
    "task_title",
    "task_mode",
    "repository",
    "expected_main",
    "base_branch",
    "base_sha",
    "head_branch",
    "initial_head_sha",
    "current_head_sha",
    "authorized_scope",
    "allowed_paths",
    "forbidden_paths",
    "authorized_findings",
    "prohibited_actions",
    "applicable_rules",
    "required_tests",
    "required_evidence",
    "founder_gates",
    "external_disclosure",
    "retry_limit",
    "stop_conditions",
    "builder_agent",
    "auditor_agent",
    "requested_agents",
    "requested_actions"
  ],
  "properties": {
    "task_id": {
      "type": "string",
      "minLength": 1
    },
    "task_title": {
      "type": "string",
      "minLength": 1
    },
    "task_mode": {
      "type": "string",
      "enum": [
        "READ_ONLY_AUDIT",
        "AUTHORIZED_REMEDIATION",
        "GOVERNANCE_DOCUMENTATION",
        "RUNTIME_DEVELOPMENT",
        "VISUAL_REMEDIATION"
      ]
    },
    "repository": {
      "type": "string",
      "pattern": "^[^/]+/[^/]+$"
    },
    "expected_main": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "base_branch": {
      "type": "string",
      "minLength": 1
    },
    "base_sha": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "head_branch": {
      "type": "string",
      "minLength": 1
    },
    "initial_head_sha": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "current_head_sha": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "authorized_scope": {
      "type": "string",
      "minLength": 1
    },
    "allowed_paths": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "forbidden_paths": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "authorized_findings": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "prohibited_actions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "applicable_rules": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "pattern": "^PDA-R[0-9]{3}$"
      }
    },
    "required_tests": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "required_evidence": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "founder_gates": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "founder_experience_required",
        "founder_experience_result",
        "founder_governance_review",
        "ready_authorization",
        "merge_authorization",
        "preview_deletion_authorization",
        "next_phase_authorization"
      ],
      "properties": {
        "founder_experience_required": {
          "type": "boolean"
        },
        "founder_experience_result": {
          "type": "string",
          "enum": [
            "PASS",
            "REJECTED",
            "PENDING",
            "NOT_REQUIRED",
            "NOT_RUN"
          ]
        },
        "founder_governance_review": {
          "type": "string",
          "enum": [
            "REQUIRED",
            "APPROVED",
            "REJECTED",
            "NOT_REQUIRED"
          ]
        },
        "ready_authorization": {
          "type": "string",
          "enum": [
            "PRESENT",
            "NOT_PRESENT"
          ]
        },
        "merge_authorization": {
          "type": "string",
          "enum": [
            "PRESENT",
            "NOT_PRESENT"
          ]
        },
        "preview_deletion_authorization": {
          "type": "string",
          "enum": [
            "PRESENT",
            "NOT_PRESENT"
          ]
        },
        "next_phase_authorization": {
          "type": "string",
          "enum": [
            "PRESENT",
            "NOT_PRESENT"
          ]
        }
      }
    },
    "external_disclosure": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "permitted",
        "services",
        "content"
      ],
      "properties": {
        "permitted": {
          "type": "boolean"
        },
        "services": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "content": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "retry_limit": {
      "type": "integer",
      "minimum": 0,
      "maximum": 10
    },
    "stop_conditions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "builder_agent": {
      "type": "string",
      "minLength": 1
    },
    "auditor_agent": {
      "type": "string",
      "minLength": 1
    },
    "requested_agents": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "requested_actions": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "evidence_manifest_path": {
      "type": "string"
    },
    "notes": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  }
}
