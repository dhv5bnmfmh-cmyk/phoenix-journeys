{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"https://phoenix.local/schemas/task_contract.schema.json",
  "type":"object","additionalProperties":true,
  "required":["task_id","task_title","task_mode","repository","base_branch","base_sha","head_branch","current_head_sha","authorized_scope","allowed_paths","forbidden_paths","authorized_findings","prohibited_actions","applicable_rules","required_tests","required_evidence","founder_gates","external_disclosure","retry_limit","stop_conditions","requested_actions"],
  "properties": {
    "task_id":{"type":"string","minLength":1},"task_title":{"type":"string","minLength":1},"task_mode":{"enum":["READ_ONLY_AUDIT","GOVERNANCE_DOCUMENTATION","AUTHORIZED_REMEDIATION","RUNTIME_DEVELOPMENT","VISUAL_REMEDIATION"]},"repository":{"type":"string","pattern":"^[^/]+/[^/]+$"},"expected_main":{"type":"string","pattern":"^[0-9a-f]{40}$"},"base_branch":{"type":"string","minLength":1},"base_sha":{"type":"string","pattern":"^[0-9a-f]{40}$"},"head_branch":{"type":"string","minLength":1},"initial_head_sha":{"type":"string","pattern":"^[0-9a-f]{40}$"},"current_head_sha":{"type":"string","pattern":"^[0-9a-f]{40}$"},"authorized_scope":{"type":"string","minLength":1},
    "allowed_paths":{"type":"array","items":{"type":"string","minLength":1},"minItems":1,"uniqueItems":true},"forbidden_paths":{"type":"array","items":{"type":"string","minLength":1},"uniqueItems":true},"authorized_findings":{"type":"array","items":{"type":"string"},"uniqueItems":true},"prohibited_actions":{"type":"array","items":{"type":"string"},"uniqueItems":true},"applicable_rules":{"type":"array","items":{"type":"string","pattern":"^PDA-R\\d{3}$"},"minItems":1,"uniqueItems":true},"required_tests":{"type":"array","items":{"type":"string"}},"required_evidence":{"type":"array","items":{"type":"string"}},"founder_gates":{"type":"object"},"external_disclosure":{"type":"object","required":["permitted"],"properties":{"permitted":{"type":"boolean"}},"additionalProperties":true},"retry_limit":{"type":"integer","minimum":0},"stop_conditions":{"type":"array","items":{"type":"string"}},"requested_actions":{"type":"array","items":{"type":"string"}}
  }
}
