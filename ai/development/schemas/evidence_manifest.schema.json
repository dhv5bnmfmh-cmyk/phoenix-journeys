{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://phoenix.local/schemas/evidence_manifest.schema.json",
  "title": "Phoenix Trusted Evidence Manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "manifest_version",
    "trust_class",
    "repository",
    "pr_number",
    "base_branch",
    "base_sha",
    "head_branch",
    "candidate_sha",
    "candidate_tree",
    "task_contract_digest",
    "governance_body_digest",
    "workflow_run_id",
    "run_attempt",
    "produced_at",
    "required_evidence_types",
    "evidence"
  ],
  "properties": {
    "manifest_version": {
      "const": "2.1.0"
    },
    "trust_class": {
      "const": "TRUSTED_RUNNER_GENERATED"
    },
    "repository": {
      "type": "string",
      "pattern": "^[^/]+/[^/]+$"
    },
    "pr_number": {
      "type": "integer",
      "minimum": 1
    },
    "base_branch": {
      "type": "string",
      "minLength": 1
    },
    "base_sha": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "head_branch": {
      "type": "string",
      "minLength": 1
    },
    "candidate_sha": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "candidate_tree": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "task_contract_digest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "governance_body_digest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "workflow_run_id": {
      "type": "string",
      "minLength": 1
    },
    "run_attempt": {
      "type": "integer",
      "minimum": 1
    },
    "produced_at": {
      "type": "string",
      "format": "date-time"
    },
    "required_evidence_types": {
      "type": "array",
      "items": {
        "enum": [
          "repository",
          "commit",
          "diff",
          "changed_paths",
          "test",
          "ci",
          "workflow",
          "founder"
        ]
      },
      "uniqueItems": true
    },
    "evidence": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/evidenceEntry"
      }
    }
  },
  "$defs": {
    "evidenceEntry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "evidence_id",
        "evidence_type",
        "source",
        "command_or_path",
        "candidate_sha",
        "produced_at",
        "result",
        "evidence_level",
        "limitations",
        "base_sha",
        "task_contract_digest",
        "governance_body_digest",
        "workflow_run_id",
        "run_attempt"
      ],
      "properties": {
        "evidence_id": {
          "type": "string",
          "minLength": 1
        },
        "evidence_type": {
          "enum": [
            "repository",
            "commit",
            "diff",
            "changed_paths",
            "test",
            "ci",
            "workflow",
            "founder"
          ]
        },
        "source": {
          "type": "string",
          "minLength": 1
        },
        "command_or_path": {
          "type": "string",
          "minLength": 1
        },
        "candidate_sha": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        },
        "produced_at": {
          "type": "string",
          "format": "date-time"
        },
        "result": {
          "enum": [
            "PASS",
            "BLOCKED",
            "FAILURE",
            "NOT_APPLICABLE"
          ]
        },
        "evidence_level": {
          "enum": [
            "VERIFIED",
            "PARTIALLY_VERIFIED",
            "UNVERIFIED",
            "CONTRADICTORY"
          ]
        },
        "limitations": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        },
        "base_sha": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        },
        "task_contract_digest": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "governance_body_digest": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "workflow_run_id": {
          "type": "string",
          "minLength": 1
        },
        "run_attempt": {
          "type": "integer",
          "minimum": 1
        }
      }
    }
  }
}
