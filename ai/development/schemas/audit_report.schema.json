{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"https://phoenix.local/schemas/audit_report.schema.json",
  "type":"object","additionalProperties":false,
  "required":["report_id","repository","pr_number","base_sha","candidate_sha","candidate_tree","trusted_runner_sha","workflow_run_id","run_attempt","deterministic_result","ai_review_result","founder_gate_result","final_agent_decision","identity","evidence_manifest","findings","produced_at"],
  "properties": {
    "report_id":{"type":"string","minLength":1},"repository":{"type":"string","pattern":"^[^/]+/[^/]+$"},"pr_number":{"type":"integer","minimum":1},"base_sha":{"type":"string","pattern":"^[0-9a-f]{40}$"},"candidate_sha":{"type":"string","pattern":"^[0-9a-f]{40}$"},"candidate_tree":{"type":"string","pattern":"^[0-9a-f]{40}$"},"trusted_runner_sha":{"type":"string","pattern":"^[0-9a-f]{40}$"},"workflow_run_id":{"type":"string","minLength":1},"run_attempt":{"type":"integer","minimum":1},
    "deterministic_result":{"enum":["PASS","BLOCKED","FAILURE"]},"ai_review_result":{"enum":["NOT_RUN","PASS","REQUIRES_REVISION"]},"founder_gate_result":{"enum":["REQUIRED","NOT_REQUIRED","APPROVED","NOT_APPROVED"]},"final_agent_decision":{"type":"string","minLength":1},"identity":{"type":"object"},"evidence_manifest":{"type":"object"},"findings":{"type":"array"},"produced_at":{"type":"string","format":"date-time"}
  }
}
